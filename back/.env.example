# plantilla de variables de entorno del backend
# copiar este archivo como .env y completar los valores
# el .env no se sube al repositorio porque tiene credenciales

# conexion a mongodb (local o atlas)
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster.xxxxx.mongodb.net

# nombre de la base
DB_NAME=AH20232CP1

# puerto del servidor
PORT=3333

# clave con la que se firman y verifican los tokens jwt
# tiene que ser larga y secreta, no usar esta
JWT_SECRET=cambiar_por_una_clave_larga_y_secreta

# cuanto dura la sesion
JWT_EXPIRES=2h

# desde que origen acepto pedidos (el front de vite)
CORS_ORIGIN=http://localhost:5173

# opcional: solo si node no resuelve los registros SRV de mongodb+srv en tu red
# DNS_SERVERS=1.1.1.1,8.8.8.8
